<?xml version="1.0"?>
<!--
  HiveBr didactic SCARA cell.

  The shell follows the proportions of a commercial SCARA (ABB IRB 910SC
  class): a heavy cylindrical base, a white shoulder housing, two slim arms
  with an orange safety stripe and a vertical quill with an electromagnet.
  The shoulder sits above the conveyor, so the prismatic joint must lower the
  magnet before it can touch a part.

  The model is intentionally made of primitives (box/cylinder) so it can be
  parsed and drawn without external mesh files.  The kinematic chain is:

    base_link -> joint_1 (revolute Z) -> link_1
              -> joint_2 (revolute Z) -> link_2
              -> joint_3 (prismatic Z) -> link_3
              -> joint_4 (fixed) -> tool_link

  The tool point is the lower face of the magnet at link_3 local z = 0, which
  is also the origin of tool_link.  Student activity: the file in
  web/templates/scara_cell.urdf has the joint origins left as placeholders.
  Fill them with the values below and the simulator can reach the conveyor and
  the baskets.
-->
<robot name="hivebr_scara">

  <material name="abb_white">
    <color rgba="0.93 0.94 0.96 1"/>
  </material>
  <material name="abb_dark">
    <color rgba="0.16 0.18 0.22 1"/>
  </material>
  <material name="abb_orange">
    <color rgba="0.96 0.55 0.12 1"/>
  </material>
  <material name="steel">
    <color rgba="0.62 0.66 0.72 1"/>
  </material>
  <material name="magnet">
    <color rgba="0.24 0.55 0.95 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.40" length="0.20"/></geometry>
      <material name="abb_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.31" rpy="0 0 0"/>
      <geometry><cylinder radius="0.32" length="0.22"/></geometry>
      <material name="abb_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.44" rpy="0 0 0"/>
      <geometry><cylinder radius="0.34" length="0.04"/></geometry>
      <material name="abb_orange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.77" rpy="0 0 0"/>
      <geometry><cylinder radius="0.22" length="0.62"/></geometry>
      <material name="abb_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 1.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.24" length="0.06"/></geometry>
      <material name="abb_dark"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.24" length="0.22"/></geometry>
      <material name="abb_white"/>
    </visual>
    <visual>
      <origin xyz="0.80 0 0.05" rpy="0 0 0"/>
      <geometry><box size="1.48 0.28 0.22"/></geometry>
      <material name="abb_white"/>
    </visual>
    <visual>
      <origin xyz="0.80 0.145 0.09" rpy="0 0 0"/>
      <geometry><box size="1.30 0.02 0.06"/></geometry>
      <material name="abb_orange"/>
    </visual>
    <visual>
      <origin xyz="0.55 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.80 0.10 0.05"/></geometry>
      <material name="abb_dark"/>
    </visual>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.20" length="0.20"/></geometry>
      <material name="abb_white"/>
    </visual>
    <visual>
      <origin xyz="0.70 0 0.02" rpy="0 0 0"/>
      <geometry><box size="1.32 0.24 0.20"/></geometry>
      <material name="abb_white"/>
    </visual>
    <visual>
      <origin xyz="0.70 0.125 0.05" rpy="0 0 0"/>
      <geometry><box size="1.16 0.02 0.05"/></geometry>
      <material name="abb_orange"/>
    </visual>
    <visual>
      <origin xyz="0.45 0 -0.09" rpy="0 0 0"/>
      <geometry><box size="0.60 0.08 0.04"/></geometry>
      <material name="abb_dark"/>
    </visual>
  </link>

  <link name="link_3">
    <!-- The electromagnet is the tool: its lower face is local z = 0, the
         exact point returned by urdf.tip(). The quill that connects it to the
         wrist is drawn as a telescopic shaft by the canvas, so it can stretch
         when d3 goes negative. -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.04"/></geometry>
      <material name="magnet"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><cylinder radius="0.09" length="0.10"/></geometry>
      <material name="abb_dark"/>
    </visual>
  </link>

  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="magnet"/>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 1.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="120" velocity="3.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="1.60 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.70" upper="2.70" effort="80" velocity="3.0"/>
  </joint>

  <joint name="joint_3" type="prismatic">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="1.40 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.00" upper="0.55" effort="60" velocity="1.0"/>
  </joint>

  <joint name="joint_4" type="fixed">
    <parent link="link_3"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
